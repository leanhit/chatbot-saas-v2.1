# Copy to .env and fill in real values. NEVER commit .env.
# Used by app-setup/docker-compose.yml

# PostgreSQL — shared password for all hub databases (chatbot_user)
DB_PASSWORD=change_me_strong_password

# MinIO root credentials
MINIO_ROOT_USER=change_me_minio_user
MINIO_ROOT_PASSWORD=change_me_minio_password_32chars_min

# RabbitMQ credentials
RABBITMQ_USER=change_me_rabbit_user
RABBITMQ_PASSWORD=change_me_rabbit_password

# NOTE: app-setup/pgbouncer-userlist.txt must contain the md5 hash of DB_PASSWORD.
# Regenerate after changing DB_PASSWORD:
#   echo '"chatbot_user" "md5'$(echo -n "YOUR_PASSWORD" | md5sum | cut -d' ' -f1)'"' > pgbouncer-userlist.txt
# Or use plaintext: "chatbot_user" "YOUR_PASSWORD" (auth_type=plain accepts both)
