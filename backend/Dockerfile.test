# Test Dockerfile for Chatbot SaaS v2.1
# Multi-stage build for running tests in Docker

# Stage 1: Build
FROM eclipse-temurin:21-jdk AS build

# Install build dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy gradle files
COPY build.gradle settings.gradle gradlew ./
COPY gradle ./gradle
COPY src ./src

# Build the application with tests
RUN ./gradlew build --no-daemon

# Stage 2: Test Runtime
FROM eclipse-temurin:21-jdk

# Install test dependencies
RUN apt-get update && apt-get install -y \
    curl \
    docker-cli \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy JAR file from build stage
COPY --from=build /build/build/libs/*.jar app.jar

# Copy test resources
COPY --from=build /build/build/test-results ./test-results
COPY --from=build /build/build/reports ./reports

# Copy application configuration
COPY --from=build /build/src/main/resources/application*.yml ./config/
COPY --from=build /build/src/test/resources/application-test.yml ./config/

# Expose port
EXPOSE 8080

# Set JVM options for testing
ENV JAVA_OPTS="-Xms512m -Xmx1g -XX:+UseG1GC -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0"

# Set Spring profile for testing
ENV SPRING_PROFILES_ACTIVE=test

# Run tests by default
CMD ["sh", "-c", "java $JAVA_OPTS -Dspring.profiles.active=$SPRING_PROFILES_ACTIVE -jar app.jar"]
