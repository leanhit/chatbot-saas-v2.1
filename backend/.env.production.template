# ========================================
# DATABASE CONFIGURATION
# ========================================
POSTGRES_PASSWORD=your_strong_256bit_password_here_change_me
IDENTITY_DB_PASSWORD=your_identity_db_password_here_change_me
USER_DB_PASSWORD=your_user_db_password_here_change_me
TENANT_DB_PASSWORD=your_tenant_db_password_here_change_me
APP_DB_PASSWORD=your_app_db_password_here_change_me
BILLING_DB_PASSWORD=your_billing_db_password_here_change_me
WALLET_DB_PASSWORD=your_wallet_db_password_here_change_me
CONFIG_DB_PASSWORD=your_config_db_password_here_change_me
MESSAGE_DB_PASSWORD=your_message_db_password_here_change_me

# ========================================
# SECURITY CONFIGURATION
# ========================================
JWT_SECRET=your_64_character_random_jwt_secret_key_here_minimum_length_change_me
MINIO_ROOT_PASSWORD=your_minio_256bit_password_here_change_me
RABBITMQ_PASSWORD=your_rabbitmq_256bit_password_here_change_me

# ========================================
# PRODUCTION DOMAINS
# ========================================
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ========================================
# SSL/TLS CONFIGURATION
# ========================================
SSL_CERT_PATH=/etc/ssl/certs/yourdomain.crt
SSL_KEY_PATH=/etc/ssl/private/yourdomain.key

# ========================================
# PRODUCTION SETTINGS
# ========================================
SPRING_PROFILES_ACTIVE=production
LOG_LEVEL=WARN
DEBUG=false

# ========================================
# DATABASE CONNECTIONS
# ========================================
IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/identity_db
USER_DB_URL=jdbc:postgresql://localhost:5434/user_db
TENANT_DB_URL=jdbc:postgresql://localhost:5435/tenant_db
APP_DB_URL=jdbc:postgresql://localhost:5436/app_db
BILLING_DB_URL=jdbc:postgresql://localhost:5437/billing_db
WALLET_DB_URL=jdbc:postgresql://localhost:5438/wallet_db
CONFIG_DB_URL=jdbc:postgresql://localhost:5439/config_db
MESSAGE_DB_URL=jdbc:postgresql://localhost:5440/message_db

# ========================================
# REDIS CONFIGURATION
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=your_redis_password_here_change_me

# ========================================
# MINIO CONFIGURATION
# ========================================
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_256bit_password_here_change_me

# ========================================
# RABBITMQ CONFIGURATION
# ========================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=your_rabbitmq_256bit_password_here_change_me

# ========================================
# gRPC CONFIGURATION
# ========================================
IDENTITY_GRPC_PORT=50051
USER_GRPC_PORT=50052
TENANT_GRPC_PORT=50053
APP_GRPC_PORT=50054
BILLING_GRPC_PORT=50055
WALLET_GRPC_PORT=50056
CONFIG_GRPC_PORT=50057
MESSAGE_GRPC_PORT=50058

# ========================================
# SECURITY HEADERS
# ========================================
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Tenant-Key,Accept

# ========================================
# MONITORING
# ========================================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized
MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true
