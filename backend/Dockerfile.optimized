# Optimized Production Dockerfile for Chatbot SaaS v2.1
# Multi-stage build with security and performance optimizations

# Stage 1: Build
FROM openjdk:21-jdk-slim as build

# Install build dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy gradle files
COPY build.gradle settings.gradle gradle/ ./
COPY src ./src

# Build the application
RUN ./gradlew build -x test --no-daemon --max-workers=4 --parallel

# Stage 2: Runtime
FROM openjdk:21-jre-slim as runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    tini \
    ca-certificates \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Set timezone
ENV TZ=Asia/Ho_Chi_Minh
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Create application user with specific UID/GID
RUN groupadd -r appuser -g 1001 && \
    useradd -r -g appuser -u 1001 -d /app -s /bin/bash appuser

# Set working directory
WORKDIR /app

# Copy JAR file from build stage
COPY --from=build /build/build/libs/*.jar app.jar

# Create necessary directories
RUN mkdir -p /app/logs /app/uploads /app/temp /app/config

# Copy application configuration
COPY --from=build /build/src/main/resources/application*.yml ./config/

# Create health check script
COPY docker/health-check.sh /app/health-check.sh
RUN chmod +x /app/health-check.sh

# Change ownership to appuser
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Create PID file directory
RUN mkdir -p /app/tmp && \
    chown appuser:appuser /app/tmp

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD /app/health-check.sh

# Expose port
EXPOSE 8080

# Set JVM options for production with memory optimization
ENV JAVA_OPTS="-Xms512m -Xmx1g \
    -XX:+UseG1GC \
    -XX:+UseContainerSupport \
    -XX:MaxRAMPercentage=75.0 \
    -XX:+UnlockExperimentalVMOptions \
    -XX:+UseCGroupMemoryLimitForHeap \
    -XX:G1HeapRegionSize=16m \
    -XX:+UseStringDeduplication \
    -XX:+OptimizeStringConcat \
    -XX:+UseCompressedOops \
    -XX:+UseCompressedClassPointers \
    -Djava.security.egd=file:/dev/./urandom \
    -Dspring.profiles.active=production \
    -Dlogging.file.name=/app/logs/application.log \
    -Dmanagement.endpoints.web.exposure.include=health,info,metrics,prometheus \
    -Dmanagement.endpoint.health.show-details=when-authorized"

# Set Spring Boot specific options
ENV SPRING_OPTS="--spring.config.location=classpath:/application.yml,/app/config/ \
    --spring.jmx.enabled=false \
    --spring.output.ansi.enabled=never \
    --logging.level.root=WARN \
    --logging.level.com.chatbot=INFO"

# Create startup script
RUN echo '#!/bin/bash\n\
echo "Starting Chatbot SaaS v2.1..."\n\
echo "Java Version: $(java -version 2>&1 | head -n 1)"\n\
echo "Memory: $(free -h | grep Mem)"\n\
echo "Disk: $(df -h /app)"\n\
exec java $JAVA_OPTS $SPRING_OPTS -jar app.jar' > /app/start.sh && \
    chmod +x /app/start.sh

# Start application with tini as PID 1
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/app/start.sh"]
