# Copy to .env and fill in real values. NEVER commit .env.
# Used by app-deploy/docker-compose.yml

# Database
DB_USER=chatbot_user
DB_PASSWORD=change_me_strong_password

# JWT
JWT_SECRET=change_me_jwt_secret_32chars_min
# RS256 (default) requires an RSA key pair. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private.pem
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Then paste the base64 body (single line, no PEM headers) below. NEVER commit the .pem files.
JWT_ALGORITHM=RS256
RSA_PRIVATE_KEY=change_me_base64_pkcs8_private_key
RSA_PUBLIC_KEY=change_me_base64_x509_public_key

# RabbitMQ (must match app-setup RABBITMQ_USER / RABBITMQ_PASSWORD)
RABBITMQ_USER=change_me_rabbitmq_user
RABBITMQ_PASSWORD=change_me_rabbitmq_password

# MinIO
MINIO_ACCESS_KEY=change_me_minio_access_key
MINIO_SECRET_KEY=change_me_minio_secret_key_32chars_min
MINIO_BUCKET=chatbot-files

# CORS
ALLOWED_ORIGINS=http://localhost:3003,http://localhost:8080
