# Copy to .env and fill in real values. NEVER commit .env.
# Used by app-deploy/docker-compose.yml

# Database
DB_USER=chatbot_user
DB_PASSWORD=change_me_strong_password

# JWT
JWT_SECRET=change_me_jwt_secret_32chars_min

# MinIO
MINIO_ACCESS_KEY=change_me_minio_access_key
MINIO_SECRET_KEY=change_me_minio_secret_key_32chars_min
MINIO_BUCKET=chatbot-files

# CORS
ALLOWED_ORIGINS=http://localhost:3003,http://localhost:8080
