# Test Dockerfile for Chatbot SaaS v2.1 Backend
# Build and run tests in Docker container

FROM eclipse-temurin:21-jdk

# Install build dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy gradle files
COPY backend/build.gradle backend/settings.gradle backend/gradlew ./
COPY backend/gradle ./gradle
COPY backend/src ./src

# Make gradlew executable
RUN chmod +x gradlew

# Build the application with tests
RUN ./gradlew build -x test --no-daemon

# Run only Phase 4 routing tests (unit tests)
RUN ./gradlew test --tests "com.chatbot.core.routing.service.*" --no-daemon

# Expose port
EXPOSE 8080

# Set JVM options for testing
ENV JAVA_OPTS="-Xms512m -Xmx1g -XX:+UseG1GC -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0"

# Set Spring profile for testing
ENV SPRING_PROFILES_ACTIVE=test

# Run tests by default
CMD ["sh", "-c", "./gradlew test --no-daemon"]
